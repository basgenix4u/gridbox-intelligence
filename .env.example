# ---------------------------------------------------------------------------
# Gridbox Intelligence — environment configuration
#
# Copy to `.env.local` for local development. Never commit a real `.env`.
# Vercel: set these in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ----------------------------------------------------
# Use the TRANSACTION POOLER for runtime queries (port 6543).
#
# Two things that are easy to get wrong and cost real debugging time:
#
#   1. The pooler hostname and username are NOT the ones in the generic
#      dashboard snippet. This project's pooler is aws-1-<region>, not aws-0,
#      and the user is gridbox_app.<project-ref>. Confirm both per project —
#      the wrong pooler answers "tenant/user not found".
#   2. The direct host db.<ref>.supabase.co publishes an AAAA record only.
#      Vercel's Lambdas egress over IPv4, so any connection string using it
#      will fail from production. The pooler is the only viable route.
#
# The game's tables live in a dedicated `gridbox` schema rather than `public`,
# so they cannot collide with anything already in the project. See
# db/bootstrap.sql for the one-time schema and role setup.
#
# No `?pgbouncer=true` is needed: db/client.ts sets `prepare: false`, which is
# how the postgres.js driver disables prepared statements for the pooler.
DATABASE_URL=postgresql://gridbox_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. Only usable from a network that can reach IPv6; migrations fall back
# to DATABASE_URL (the pooler) when this is unset.
# DIRECT_URL=postgresql://gridbox_app.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# --- Auth -------------------------------------------------------------------
# HS256 key for anonymous session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Rotating it invalidates all sessions.
AUTH_SECRET=replace-me-with-64-random-hex-characters

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist of browser origins. `*` suits local development.
#
# In production the API *fails closed*: an environment that does not validate
# approves no cross-origin request at all, and /readyz reports the deployment
# as degraded. Pin the real origins — the game is served same-origin from
# Vercel, so this list is for any other consumer of the API.
# ALLOWED_ORIGINS=https://gridbox-intelligence.vercel.app

# --- Moderation --------------------------------------------------------------
# Owner token guarding the admin endpoints (GET /v1/admin/moderation,
# POST /v1/admin/moderation/:id). Without it those endpoints answer 401 to
# everyone, which is the safe default — but then no report can ever be
# resolved. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# MODERATION_TOKEN=replace-me-with-at-least-16-characters

# --- Production invariants ---------------------------------------------------
# When NODE_ENV=production the API additionally requires ALLOWED_ORIGINS to
# list explicit origins (no `*`) and AUTH_SECRET to be set. A deployment that
# misses either boots far enough for /readyz to say so, rather than crashing
# at cold start or silently opening up.

# --- Rate limiting (optional) ------------------------------------------------
# Without these, rate limiting falls back to per-instance memory, which is
# best-effort across serverless invocations. Upstash makes it global.
# RATE_LIMIT_REDIS_URL=https://<endpoint>.upstash.io
# RATE_LIMIT_REDIS_TOKEN=<token>

# --- Client ------------------------------------------------------------------
# Runs submitted by a client older than this are rejected.
MIN_CLIENT_VERSION=0.1.0

# --- Observability (optional) -------------------------------------------------
# Injected by Vercel at build time; set manually for local runs.
# COMMIT_SHA=
SERVICE_VERSION=0.1.0
