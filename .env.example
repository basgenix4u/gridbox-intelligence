# ---------------------------------------------------------------------------
# Gridbox Intelligence — environment configuration
#
# Copy to `.env.local` for local development. Never commit a real `.env`.
# Vercel: set these in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ----------------------------------------------------
# Use the TRANSACTION POOLER for runtime queries (port 6543). Supabase's pooler
# does not support prepared statements, so `?pgbouncer=true` is required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Direct connection (port 5432) used by Drizzle migrations only. DDL cannot run
# through the pooler in transaction mode.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth -------------------------------------------------------------------
# HS256 key for anonymous session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Rotating it invalidates all sessions.
AUTH_SECRET=replace-me-with-64-random-hex-characters

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist of browser origins. `*` suits the API's public read
# endpoints; pin it to your domains before enabling authenticated writes.
ALLOWED_ORIGINS=*

# --- Rate limiting (optional) ------------------------------------------------
# Without these, rate limiting falls back to per-instance memory, which is
# best-effort across serverless invocations. Upstash makes it global.
# RATE_LIMIT_REDIS_URL=https://<endpoint>.upstash.io
# RATE_LIMIT_REDIS_TOKEN=<token>

# --- Client ------------------------------------------------------------------
# Runs submitted by a client older than this are rejected.
MIN_CLIENT_VERSION=0.1.0

# --- Observability (optional) -------------------------------------------------
# Injected by Vercel at build time; set manually for local runs.
# COMMIT_SHA=
SERVICE_VERSION=0.1.0
